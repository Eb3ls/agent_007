# Deliveroo.js game server
DELIVEROO_HOST=http://localhost:8080
DELIVEROO_TOKEN=          # BDI agent JWT (required)
DELIVEROO_TOKEN_LLM=      # LLM agent JWT (optional — enables dual-agent mode)
SERVER_AGENT_NAME=        # display name override (optional)

# LLM API (OpenAI-compatible — required when planner=llm)
LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
LLM_API_TOKEN=
LLM_MODEL=google/gemma-3-27b-it
LLM_TIMEOUT_MS=           # request timeout in ms (optional, default: none)

# Tests
RUN_LLM_TESTS=            # set to 1 to run LLM integration tests (optional)
