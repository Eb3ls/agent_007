Output: {"level":"L1","opType":"MODIFIER","selector":{"on":"goto","coords":[{"x":4,"y":7}]},"effect":{"add":10},"condition":null,"lifetime":"one-shot","target":"both","coords":null,"bonus":10,"answer":null,"token":null}

